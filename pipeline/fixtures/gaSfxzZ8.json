    {
     "widget_type": "DESCRIPTION_ROW",
     "data": {
      "@type": "type.googleapis.com/widgets.DescriptionRowData",
      "text": "آپارتمان 54 متر خوش نقشه \nطبقه دوم \nواحد تو سلمان فارسی هست \nتک خواب \nپارکینگ غیر مزاحم \nسالن مربع پرده خور \nواحد تمیز قشنگ \nکمسیون توافقی \nکابینت هایگلاس \nکف سرامیک \n4تا تک واحدی \nسرمایش کولر آبی \nگرمایش بخاری\nواحد تخلیه هست \nسرویس حموم دستشویی جدا \nنورگیر عالی مستقیم \nدسترسی 4دقیقه به مترو مدنی \nدسترسی 3 دقیقه ای به اتوبان امام علی \nمشاور املاک سیاوش \nمشاور شما بهار",
      "is_primary": true,
      "text_alignment": "RIGHT"
     }
    }
   ]
  },
